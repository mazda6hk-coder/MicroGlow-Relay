POSTGRES_DB=microglow_telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
INSTALLATION_HMAC_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-an-independent-32-character-admin-token
CONSENT_VERSION_V1=2026-09
CONSENT_VERSION_V2=v2.2026-09
PUBLIC_HOST=localhost
ADMIN_HOST=localhost

MAX_BODY_BYTES=1048576
MAX_AGGREGATED_ROWS=500
PUBLIC_RATE_LIMIT_PER_MINUTE=60
ADMIN_RATE_LIMIT_PER_MINUTE=30
GEOIP_DATABASE_PATH=/geoip/dbip-country-lite.mmdb
TRUSTED_PROXY_CIDRS=172.30.0.0/24
# 可选：Tunnel 与 Caddy 同宿主机时自动识别 Docker 网关；其他拓扑才填写明确可信来源 CIDR。
TUNNEL_PEER_CIDR=
BACKEND_SUBNET=172.30.0.0/24
DBIP_UPDATE_CHECK_INTERVAL_SECONDS=86400
# 可选：由运营方从可信渠道取得并固定当月 .mmdb.gz SHA-256。
DBIP_EXPECTED_SHA256=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
